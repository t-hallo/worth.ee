---
import { ClientRouter } from 'astro:transitions';
const { title = "Worth" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta name="color-scheme" content="dark light">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Worth" />
    <meta name="author" content="Worth" />
    <link rel="canonical" href="https://worth.ee/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Worth" />
    <meta property="og:url" content="https://worth.ee/" />
    <meta property="og:image" content="https://worth.ee/og-image.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" /></noscript>
    <script src="/theme-init.js" is:inline></script>
</head>
<body>
    <div class="container">
        <header>
            <a href="/">
                <h1><span class="logo-dots"><span></span><span></span><span></span></span></h1>
            </a>
            <div class="header-links">
                <a href="/be">Be</a>
                <a href="mailto:u@worth.ee" data-astro-reload>Mail</a>
                <button id="theme-toggle" aria-label="切换主题" class="theme-toggle">
                    <svg id="theme-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
            </div>
        </header>

        <main>
            <slot />
        </main>
    </div>

    <footer>
        <span id="carbon-footprint">🌱 0.03g CO₂</span>
        <div class="footer-links">
            <a href="/privacy">Privacy</a>
        </div>
    </footer>

    <script src="/theme-toggle.js" is:inline></script>
</body>
</html>
