---
import { ClientRouter } from 'astro:transitions';
import cssContent from '../../public/styles/global.css?raw';
const { title = "线条的博客", description = "Worth — 线条", canonical, articlePage = false } = Astro.props;
const pageUrl = canonical || `https://worth.ee${Astro.url.pathname}`;
const isNotHome = Astro.url.pathname !== '/';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta name="color-scheme" content="dark light">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="author" content="Worth" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://worth.ee/og-image.png" />
    <style set:html={cssContent} />
    <ClientRouter fallback="none" />
    <script is:inline>
        window.applyTheme=function(){var t=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme:dark)').matches,e=document.documentElement;if(t==='dark'||(!t&&d)){e.classList.add('dark');e.style.colorScheme='dark'}else{e.classList.remove('dark');e.style.colorScheme='light'}var i=document.getElementById('modal-theme-icon');if(i)i.innerHTML=e.classList.contains('dark')?'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">':'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z">'};
        window.toggleTheme=function(){var d=!document.documentElement.classList.contains('dark');document.documentElement.classList.toggle('dark');document.documentElement.style.colorScheme=d?'dark':'light';localStorage.setItem('theme',d?'dark':'light');window.applyTheme()};
        window.applyTheme();
        document.addEventListener('astro:page-load',function(){window.applyTheme()});
    </script>
</head>
<body>
    <div class="container">
        <main>
            <slot />
        </main>
    </div>

    <div id="info-tools">
        {isNotHome && <a href="/" class="info-tool" aria-label="返回首页">←</a>}
        {!isNotHome && <>
            <button id="modal-theme-toggle" class="info-tool" aria-label="切换主题">
                <svg id="modal-theme-icon" viewBox="0 0 24 24"></svg>
            </button>
            <a href="mailto:a@worth.ee" class="info-tool" aria-label="发送邮件">
                <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
        </>}
    </div>

    <button class="info-trigger" aria-label="关于本站">ⓘ</button>
    <div class="info-sheet">
        <div class="info-sheet-inner">
            <div class="info-col">
                <h3>版权</h3>
                <p>© 2026 线条</p>
                <p>本网站所有内容均由人类撰写、编辑、校对。我们不使用 AI 生成、润色或翻译文章。除非特别注明，作品均为线条原创。</p>
            </div>
            <div class="info-col">
                <h3>隐私</h3>
                <p>This is a static file. No database, no backend, no log aggregation. We don't track you in any form. No cookies, no analytics scripts, no user profiling, no A/B testing, no heatmaps, no ads. That's it.</p>
            </div>
        </div>
    </div>

    <button class="info-tool back-to-top" aria-label="返回顶部">
        <svg viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <script is:inline>
        (function(){
            var b=document.querySelector('.back-to-top'),v=false;
            window.addEventListener('scroll',function(){var s=window.scrollY>300;if(s!==v){v=s;b.classList.toggle('is-visible',s)}},{passive:true});
            b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})});
            document.addEventListener('astro:page-load',function(){b=document.querySelector('.back-to-top');b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'})})});
        })();
        document.addEventListener('astro:page-load',function(){
            var t=document.getElementById('modal-theme-toggle');
            if(t)t.addEventListener('click',function(){
                var i=document.getElementById('modal-theme-icon');
                if(i){
                    i.style.transition='transform .4s cubic-bezier(.4,0,.2,1), opacity .4s ease';
                    i.style.transform='rotate(180deg)';
                    i.style.opacity='0';
                    setTimeout(function(){
                        if(window.toggleTheme)window.toggleTheme();
                        i.style.transition='none';
                        i.style.transform='rotate(0deg)';
                        i.style.opacity='1';
                        setTimeout(function(){
                            i.style.transition='transform .4s cubic-bezier(.4,0,.2,1)';
                            i.style.transform='rotate(180deg)';
                            setTimeout(function(){i.style.transform='rotate(0deg)'},400);
                        },20);
                    },200);
                } else {
                    if(window.toggleTheme)window.toggleTheme();
                }
            })
        });
        (function(){if(window.__c)return;window.__c=true;document.addEventListener('click',function(e){
            var t=document.querySelector('.info-trigger'),s=document.querySelector('.info-sheet');
            if(!t||!s)return;
            if(e.target.closest('.info-trigger'))s.classList.toggle('is-visible');
            else if(!e.target.closest('.info-sheet'))s.classList.remove('is-visible')
        })})();
    </script>
</body>
</html>
