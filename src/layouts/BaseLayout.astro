---
const { title = "Worth" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- SEO -->
    <meta name="description" content="Worth" />
    <meta name="author" content="Worth" />
    <link rel="canonical" href="https://worth.ee/" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Worth" />
    <meta property="og:url" content="https://worth.ee/" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://worth.ee/">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Cache meta (supplements HTTP headers for proxy caches) -->
    <meta http-equiv="Cache-Control" content="public, max-age=3600">
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" /></noscript>
    
    <style is:global>
        :root{--bg:#fff;--text-primary:#111;--text-secondary:#222;--text-tertiary:#777;--text-muted:#888;--border:#eee;--hover:#000}
        .dark{--bg:#0a0a0a;--text-primary:#fafafa;--text-secondary:#a3a3a3;--text-tertiary:#a3a3a3;--text-muted:#a3a3a3;--border:#262626;--hover:#fff}
        *{margin:0;padding:0;box-sizing:border-box}
        html{scroll-behavior:smooth}
        body{font-family:DM Sans,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,sans-serif;background-color:var(--bg);color:var(--text-primary);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;line-height:1.7;display:flex;flex-direction:column;min-height:100vh;padding:0 24px 48px;transition:background-color .2s ease,color .2s ease}
        .container{max-width:620px;width:100%;margin:0 auto;flex:1}
        header{margin-bottom:28px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;padding:16px 0;background:rgba(255,255,255,.75);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:background .2s ease}
        .dark header{background:rgba(10,10,10,.75)}
        header h1{font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--text-primary);display:flex;align-items:center}
        .logo-dots{display:inline-flex;gap:2px;align-items:center;padding:8px 12px;margin-left:-8px;cursor:pointer}
        .logo-dots span{width:2.5px;height:2.5px;border-radius:50%;background-color:var(--text-primary);display:inline-block}
        .logo-dots span:nth-child(1){opacity:.4}.logo-dots span:nth-child(2){opacity:.6}.logo-dots span:nth-child(3){opacity:.8}
        header a{color:inherit;text-decoration:none}
        .header-links{display:flex;gap:16px;align-items:center}
        .header-links a{font-size:12px;color:var(--text-tertiary);text-decoration:none;transition:color .2s ease}
        .header-links a:hover{color:var(--hover)}
        .theme-toggle{background:none;border:none;color:inherit;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center}
        .theme-toggle svg{width:16px;height:16px}
        .intro{margin-bottom:40px}
        .intro p{font-family:DM Sans,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,sans-serif;font-size:14px;font-weight:500;color:var(--text-primary);margin-bottom:16px}
        .intro p:last-child{margin-bottom:0}
        .post-content .attr{font-size:12px;color:var(--text-muted);margin-top:2px;margin-bottom:0;font-weight:400}
        .post-list{list-style:none;border-top:1px solid var(--border)}
        .post-item{border-bottom:1px solid var(--border)}
        .post-link{display:flex;align-items:baseline;padding:10px 0;text-decoration:none;color:inherit;transition:all .2s cubic-bezier(.16,1,.3,1)}
        .post-link:hover{transform:translateX(4px)}
        .post-link:hover .post-title{color:var(--hover)}
        .post-link:hover .post-date{color:#555}
        .post-date{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;color:var(--text-muted);width:105px;flex-shrink:0;letter-spacing:-.02em;transition:color .2s ease}
        .post-title{font-family:DM Sans,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,sans-serif;font-size:14px;font-weight:500;color:var(--text-primary);transition:color .2s ease;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
        .post-content{max-width:620px;margin:0 auto;padding-top:0}
        .post-content h1{font-size:1.5rem;font-weight:700;letter-spacing:-.02em;margin:0 0 1rem;line-height:1.3}
        .post-content h2{font-size:1.1rem;font-weight:600;margin:1.5rem 0 .5rem}
        .post-content p{font-size:.9375rem;line-height:1.7;color:var(--text-secondary);margin:0 0 .875rem;letter-spacing:.01em}
        .post-content a{text-decoration:underline;text-underline-offset:2px}
        .post-meta{display:flex;gap:1rem;font-size:.75rem;color:var(--text-tertiary);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border)}
        footer{max-width:620px;width:100%;margin:48px auto 0;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--text-tertiary);flex-wrap:wrap}
        footer a{color:var(--text-tertiary);text-decoration:none;transition:color .2s ease}
        footer a:hover{color:var(--hover)}
        .footer-links{display:flex;gap:16px;align-items:center}
        .post-footer{border-top:1px solid var(--border);margin-top:40px;padding-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
        .human-written{font-size:12px;color:var(--text-muted);font-style:italic}
        .post-actions{display:flex;gap:12px}
        .action-btn{background:none;border:1px solid var(--border);color:var(--text-tertiary);font-size:12px;padding:6px 14px;border-radius:4px;cursor:pointer;transition:all .2s ease;font-family:inherit}
        .action-btn:hover{border-color:var(--hover);color:var(--hover)}
        .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:100;align-items:center;justify-content:center;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
        .modal-glass{background:rgba(255,255,255,.65);padding:48px;border-radius:16px;max-width:360px;width:90%;position:relative;box-shadow:0 8px 32px rgba(0,0,0,.08);border:1px solid rgba(255,255,255,.3)}
        .dark .modal-glass{background:rgba(20,20,20,.65);border:1px solid rgba(255,255,255,.1)}
        .modal-close{position:absolute;top:16px;right:16px;background:none;border:none;font-size:16px;cursor:pointer;color:var(--text-tertiary);opacity:.6;transition:opacity .2s}
        .modal-close:hover{opacity:1}
        #subscribe-form{display:flex;flex-direction:column;gap:12px}
        #subscribe-email{padding:14px 16px;border:1px solid rgba(0,0,0,.08);border-radius:8px;font-size:14px;font-family:inherit;background:rgba(255,255,255,.5);color:var(--text-primary);outline:none;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
        .dark #subscribe-email{background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1)}
        #subscribe-email:focus{border-color:var(--text-tertiary)}
        #subscribe-form button{padding:14px 20px;background:var(--text-primary);color:var(--bg);border:none;border-radius:8px;font-size:13px;cursor:pointer;font-family:inherit;font-weight:500;transition:transform .1s ease}
        #subscribe-form button:active{transform:scale(.97)}
        @media (max-width:640px){
            body{padding:0 28px 32px}
            footer{font-size:13px;flex-direction:row;align-items:center;gap:8px;margin-top:32px}
            .footer-links{gap:12px}
            .post-link{flex-direction:row;align-items:baseline;padding:8px 0}
            header{padding:12px 0}
            .header-links a{font-size:13px;padding:4px 0}
            .intro p{font-size:14px;text-align:left}
            .intro p:first-child{margin-top:32px}
            .post-title{font-size:14px;max-width:170px}
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/">
                <h1><span class="logo-dots"><span></span><span></span><span></span></span></h1>
            </a>
            <div class="header-links">
                <a href="/be">Be</a>
                <a href="#subscribe" id="subscribe-link">Sub</a>
                <a href="mailto:u@worth.ee">Mail</a>
                <button id="theme-toggle" aria-label="切换主题" class="theme-toggle">
                    <svg id="theme-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
            </div>
        </header>

        <main>
            <slot />
        </main>
    </div>

    <footer>
        <span id="carbon-footprint">🌱 0.03g CO₂</span>
        <div class="footer-links">
            <a href="/privacy">Privacy</a>
        </div>
    </footer>

    <div id="subscribe-modal" class="modal-overlay">
        <div class="modal-glass">
            <button id="close-subscribe" class="modal-close">✕</button>
            <form id="subscribe-form">
                <input type="email" id="subscribe-email" placeholder="your@email.com" required>
                <button type="submit">Subscribe</button>
            </form>
        </div>
    </div>

    <script>
        // Dark mode + theme icon
        requestIdleCallback(() => {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = stored === 'dark' || (!stored && prefersDark);
            
            if (isDark) document.documentElement.classList.add('dark');
            
            const icon = document.getElementById('theme-icon');
            const sun = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>';
            const moon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>';
            
            if (icon) icon.innerHTML = isDark ? moon : sun;
            
            document.getElementById('theme-toggle')?.addEventListener('click', () => {
                const newIsDark = !document.documentElement.classList.contains('dark');
                document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', newIsDark ? 'dark' : 'light');
                if (icon) icon.innerHTML = newIsDark ? moon : sun;
            });
        });

        // Carbon footprint: static site estimate
        document.addEventListener('DOMContentLoaded', () => {
            const el = document.getElementById('carbon-footprint');
            if (!el) return;
            
            const htmlSize = document.documentElement.outerHTML.length;
            const pageWeightKB = htmlSize / 1024;
            const carbon = (pageWeightKB * 0.0015).toFixed(3);
            
            el.textContent = `🌱 ${carbon}g CO₂`;
        });

        // Subscribe modal
        const subscribeLink = document.getElementById('subscribe-link');
        const subscribeModal = document.getElementById('subscribe-modal');
        const closeSubscribe = document.getElementById('close-subscribe');

        if (subscribeLink && subscribeModal) {
            subscribeLink.addEventListener('click', (e) => {
                e.preventDefault();
                subscribeModal.style.display = 'flex';
                document.getElementById('subscribe-email')?.focus();
            });
        }

        if (closeSubscribe && subscribeModal) {
            closeSubscribe.addEventListener('click', () => subscribeModal.style.display = 'none');
        }

        if (subscribeModal) {
            subscribeModal.addEventListener('click', (e) => {
                if (e.target === subscribeModal) subscribeModal.style.display = 'none';
            });
        }

        document.getElementById('subscribe-form')?.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('subscribe-email')?.value;
            if (email) window.location.href = `mailto:u@worth.ee?subject=Subscribe&body=${encodeURIComponent(email)}`;
        });
    </script>
</body>
</html>
