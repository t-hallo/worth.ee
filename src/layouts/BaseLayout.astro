---
import { ViewTransitions } from 'astro:transitions';
const { title = "Worth", description = "Worth", canonical, articlePage = false } = Astro.props;
const pageUrl = canonical || `https://worth.ee${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta name="color-scheme" content="dark light">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="author" content="Worth" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://worth.ee/og-image.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <ViewTransitions />
    <script is:inline>
        // 主题初始化 + 切换
        (function() {
            var sun = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>';
            var moon = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>';
            
            function applyTheme() {
                var t = localStorage.getItem('theme');
                var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (t === 'dark' || (!t && d)) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.style.colorScheme = 'dark';
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.style.colorScheme = 'light';
                }
                updateIcon();
            }
            
            function updateIcon() {
                var icon = document.getElementById('theme-icon');
                if (icon) icon.innerHTML = document.documentElement.classList.contains('dark') ? moon : sun;
            }
            
            document.addEventListener('click', function(e) {
                if (e.target.closest('#theme-toggle')) {
                    var newIsDark = !document.documentElement.classList.contains('dark');
                    document.documentElement.classList.toggle('dark');
                    document.documentElement.style.colorScheme = newIsDark ? 'dark' : 'light';
                    localStorage.setItem('theme', newIsDark ? 'dark' : 'light');
                    updateIcon();
                }
            });
            
            applyTheme();
        })();
    </script>
    <script is:inline>
        document.addEventListener('astro:before-swap', function(){
            var header = document.getElementById('site-header');
            if (header) {
                header.removeAttribute('data-header-init');
            }
        });
        function initHeader() {
            var header = document.getElementById('site-header');
            if (!header || header.dataset.headerInit === 'true') return;
            header.dataset.headerInit = 'true';
            var isArticle = header.classList.contains('article-page');
            var isHidden = false;

            function hideHeader() {
                header.classList.add('is-hidden');
                isHidden = true;
            }
            function showHeader() {
                header.classList.remove('is-hidden');
                isHidden = false;
            }
            var autoHideTimer = null;
            function scheduleAutoHide() {
                if (autoHideTimer) clearTimeout(autoHideTimer);
                autoHideTimer = setTimeout(hideHeader, 1500);
            }
            if (isArticle) {
                setTimeout(hideHeader, 800);
            }
            document.addEventListener('mousemove', function(e) {
                if (isArticle && isHidden && e.clientY < 60) {
                    showHeader();
                    scheduleAutoHide();
                }
            });
            header.addEventListener('mouseenter', function() {
                if (autoHideTimer) clearTimeout(autoHideTimer);
            });
            header.addEventListener('mouseleave', function() {
                if (!isArticle) return;
                scheduleAutoHide();
            });
            document.addEventListener('scroll', function() {
                if (isArticle && window.scrollY > 100 && !isHidden) {
                    hideHeader();
                }
            });
        }
        document.addEventListener('astro:page-load', initHeader);
        if (document.readyState === 'complete') {
            initHeader();
        } else {
            document.addEventListener('DOMContentLoaded', initHeader);
        }
    </script>
</head>
<body>
    <div class="container">
<header id="site-header" class={articlePage ? 'article-page' : ''}>
            <a href="/">
                <h1><span class="logo-dots"><span></span><span></span><span></span></span></h1>
            </a>
            <div class="header-links">
                <a href="mailto:a@worth.ee">mail</a>
                <button id="theme-toggle" aria-label="切换主题" class="theme-toggle">
                    <svg id="theme-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
            </div>
        </header>

        <main>
            <slot />
        </main>
    </div>

    <footer>
        <div class="footer-links">
            <a href="/privacy">Privacy</a>
        </div>
        <span class="human-written">© 线条 · Not By AI</span>
    </footer>
</body>
</html>
