---
const { title = "Worth" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="dns-prefetch" href="https://worth.ee" />
    
    <!-- SEO -->
    <meta name="description" content="Worth" />
    <meta name="author" content="Worth" />
    <link rel="canonical" href="https://worth.ee/" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Worth" />
    <meta property="og:url" content="https://worth.ee/" />
    
    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Worth" href="/rss.xml" />
    
    <!-- Prefetch -->
    <link rel="prefetch" href="/" as="document" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" /></noscript>
    
    <style is:global>
        :root{--bg:#fff;--text-primary:#111;--text-secondary:#222;--text-tertiary:#777;--text-muted:#888;--border:#eee;--hover:#000}
        .dark{--bg:#0a0a0a;--text-primary:#fafafa;--text-secondary:#a3a3a3;--text-tertiary:#a3a3a3;--text-muted:#a3a3a3;--border:#262626;--hover:#fff}
        *{margin:0;padding:0;box-sizing:border-box}
        html{scroll-behavior:smooth}
        body{font-family:"DM Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC",sans-serif;background-color:var(--bg);color:var(--text-primary);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;line-height:1.7;display:flex;flex-direction:column;min-height:100vh;padding:48px 24px;transition:background-color .2s ease,color .2s ease}
        .container{max-width:620px;width:100%;margin:0 auto;flex:1}
        header{margin-bottom:28px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;padding:16px 0;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background .2s ease}
        .dark header{background:rgba(10,10,10,.85)}
        header h1{font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--text-primary);display:flex;align-items:center}
        .logo-dots{display:inline-flex;gap:2px;margin-left:4px;align-items:center}
        .logo-dots span{width:2.5px;height:2.5px;border-radius:50%;background-color:var(--text-primary);display:inline-block}
        .logo-dots span:nth-child(1){opacity:.4}.logo-dots span:nth-child(2){opacity:.6}.logo-dots span:nth-child(3){opacity:.8}
        header a{color:inherit;text-decoration:none}
        .intro{margin-bottom:40px}
        .intro p{font-family:"DM Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC",sans-serif;font-size:14px;font-weight:500;color:var(--text-primary);margin-bottom:16px;text-align:justify;text-justify:inter-ideograph;word-break:break-all}
        .intro p:last-child{margin-bottom:0}
        .post-list{list-style:none;border-top:1px solid var(--border)}
        .post-item{border-bottom:1px solid var(--border)}
        .post-link{display:flex;align-items:baseline;padding:10px 0;text-decoration:none;color:inherit;transition:all .2s cubic-bezier(.16,1,.3,1)}
        .post-link:hover{transform:translateX(4px)}
        .post-link:hover .post-title{color:var(--hover)}
        .post-link:hover .post-date{color:#555}
        .post-date{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;color:var(--text-muted);width:105px;flex-shrink:0;letter-spacing:-.02em;transition:color .2s ease}
        .post-title{font-family:"DM Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC",sans-serif;font-size:14px;font-weight:500;color:var(--text-primary);transition:color .2s ease}
        .post-content{max-width:620px;margin:0 auto;padding-top:0}
        .post-content h1{font-size:1.5rem;font-weight:700;letter-spacing:-.02em;margin:0 0 1rem;line-height:1.3}
        .post-content h2{font-size:1.1rem;font-weight:600;margin:1.5rem 0 .5rem}
        .post-content p{font-size:.9375rem;line-height:1.7;color:var(--text-secondary);margin:0 0 .875rem;letter-spacing:.01em}
        .post-content a{text-decoration:underline;text-underline-offset:2px}
        .post-meta{display:flex;gap:1rem;font-size:.75rem;color:var(--text-tertiary);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border)}
        .back-link{display:inline-block;margin-bottom:1.5rem;font-size:.8125rem;color:var(--text-tertiary);text-decoration:none;transition:color .2s ease}
        .back-link:hover{color:var(--hover)}
        footer{max-width:620px;width:100%;margin:48px auto 0;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text-tertiary)}
        footer a{color:var(--text-tertiary);text-decoration:none;transition:color .2s ease}
        footer a:hover{color:var(--hover)}
        .footer-links{display:flex;gap:16px;align-items:center}
        .theme-toggle{background:none;border:none;color:inherit;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center}
        .theme-toggle svg{width:14px;height:14px}
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/">
                <h1><span class="logo-dots"><span></span><span></span><span></span></span></h1>
            </a>
            <button id="theme-toggle" aria-label="切换主题" class="theme-toggle">
                <svg class="hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <svg class="block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>
        </header>

        <main>
            <slot />
        </main>
    </div>

    <footer>
        <span>Thinking 2026 ©</span>
        <div class="footer-links">
            <a href="/rss.xml">RSS</a>
            <a href="mailto:u@worth.ee">Mail</a>
        </div>
    </footer>

    <script>
        // Dark mode toggle - deferred to avoid blocking
        requestIdleCallback(() => {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && prefersDark)) {
                document.documentElement.classList.add('dark');
            }
            document.getElementById('theme-toggle')?.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
            });
        });
    </script>
</body>
</html>
