---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="No Ads / Privacy">
    <article class="post-content">
        <h1>No Ads</h1>
        <p>This website is ad-free. No tracking, no cookies, no analytics. Just content.</p>
        <p>We believe in a web that respects your attention and privacy.</p>
        
        <h2>Privacy</h2>
        <p>This website does not collect any personal data. No cookies, no analytics, no tracking.</p>
        <p>We believe privacy is a fundamental right, not a feature.</p>
    </article>
</BaseLayout>
