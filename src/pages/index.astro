---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  { title: '被解决的逻辑：AI 真正的危险不是取代你，而是让你变得可有可无', date: '2026-08-28', slug: '/posts/logic-of-the-solved' },
  { title: 'AI 作为普通技术：为什么我们不应该害怕', date: '2026-08-28', slug: '/posts/ai-as-normal-technology' },
  { title: '键盘优先的交互设计体验', date: '2025-07-02', slug: null },
  { title: '构建高效的 Figma 自动化工具链', date: '2025-05-11', slug: null },
  { title: '如何清晰组织设计系统中的变量', date: '2025-03-15', slug: null },
  { title: 'UI 设计策略与工程落地实践', date: '2022-11-21', slug: null },
  { title: '代码分支审查指南与检查清单', date: '2021-04-16', slug: null },
];

const about = `花园里边明晃晃的，红的红，绿的绿，新鲜漂亮。

花开了，就像睡醒了似的。鸟飞了，就像在天上逛似的。虫子叫了，就像虫子在说话似的。一切都活了，都有无限的本领，要做什么，就做什么。要怎么样，就怎么样，都是自由的。倭瓜愿意爬上房就爬上房，愿意爬上树就爬上树。黄瓜愿意开一个黄花，就开一个黄花，愿意结一个黄瓜，就结一个黄瓜。若都不愿意，就是一个黄瓜也不结，一朵花也不开，也沒有人问他。玉米愿意长多高就长多高，他若愿意长到天上去，也沒有人管他。`;
---

<BaseLayout title="Worth">
    <section class="intro">
        {about.trim().split('\n\n').map((paragraph) => (
            <p>{paragraph.trim()}</p>
        ))}
    </section>

    <ul class="post-list">
        {posts.map(post => (
            <li class="post-item">
                {post.slug ? (
                    <a href={post.slug} class="post-link">
                        <span class="post-date">{post.date}</span>
                        <span class="post-title">{post.title}</span>
                    </a>
                ) : (
                    <span class="post-link">
                        <span class="post-date">{post.date}</span>
                        <span class="post-title">{post.title}</span>
                    </span>
                )}
            </li>
        ))}
    </ul>
</BaseLayout>
